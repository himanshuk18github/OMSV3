[program:oms-scheduler]
process_name=%(program_name)s
command=/usr/bin/php /var/www/oms/backend/artisan schedule:work
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/oms/backend/storage/logs/scheduler.log
stopwaitsecs=3600
