[program:oms-worker]
process_name=%(program_name)s
command=/usr/bin/php /var/www/oms/backend/artisan queue:work --tries=3 --timeout=120 --sleep=3
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/www/oms/backend/storage/logs/queue-worker.log
stopwaitsecs=3600
